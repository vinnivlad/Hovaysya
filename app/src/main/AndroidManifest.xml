<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 13 and up: a runtime permission, asked for on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The one that makes this app worth writing. Not grantable at runtime: the
      person has to allow "Доступ до режиму «Не турбувати»" in system settings,
      and until they do, `setBypassDnd` is refused and a ballistic launch at
      three in the morning stays silent behind their own night mode. Declaring
      it is what lets the app open that settings page.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- For the shelter-now case, once there is a push to trigger it. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Hovaysya">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Hovaysya">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
