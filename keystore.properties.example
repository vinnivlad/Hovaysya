# Copy to `keystore.properties` and fill in. That file is gitignored; this one
# is the shape of it, with nothing secret in it.
#
# Make the keystore once:
#
#   keytool -genkeypair -v \
#     -keystore data/hovaysya.keystore \
#     -alias hovaysya -keyalg RSA -keysize 4096 -validity 10000
#
# Under `data/` because that is where every other secret in this project lives
# and because no server ever receives it: `deploy/lean.sh` carries tracked
# directories and `data/` is not one. `python -m tools.backup` copies `data/`,
# which matters more here than for anything else in it.
#
# **Losing this file loses the ability to update the app.** Android identifies an
# app by its signing key, so a build signed with a different one cannot replace
# an installed one -- every phone would have to uninstall first, and uninstalling
# wipes the secret it registered with. Back it up somewhere that is not this
# machine.

storeFile=data/hovaysya.keystore
storePassword=
keyAlias=hovaysya
keyPassword=
