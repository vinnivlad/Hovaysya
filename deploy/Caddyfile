# TLS, and nothing else. Caddy gets a certificate from Let's Encrypt, renews it
# without being asked, and hands plain HTTP to the API on localhost -- which is
# why no Python in this repository touches a private key.
#
# Replace the hostname with the one from DuckDNS. Let's Encrypt will not issue a
# certificate for a bare IP address, so a name is not optional.
hovaysya.duckdns.org {
	encode zstd gzip

	# No rate limit here on purpose. `rate_limit` is a third-party module and the
	# packaged `caddy` cannot parse it -- the directive would fail the config at
	# startup, which is a bad way to learn about it. Adding it means building Caddy
	# with xcaddy, and that is a second toolchain on the box for a service whose
	# only unauthenticated path returns `{"ok": true}`.
	#
	# What guards the token instead: 32 bytes from `secrets.token_urlsafe`, which
	# is not guessable at any rate, and fail2ban if it ever seems necessary.

	# The API is on the *other* machine, reached over the private VCN address --
	# so nothing is replicated and the app reads the database the watcher has
	# just written. `install-api.sh` writes the address in.
	#
	# `/health` stays open for a check from outside; every other path needs the
	# bearer token, which the API itself verifies. And health is the point of
	# this arrangement rather than a detail: if A is down there is nothing worth
	# showing, so the app has to be able to see that.
	#
	# Two proxies, and the split is the whole point of this block.
	#
	# `response_header_timeout 5s` was right for as long as every request
	# answered at once: a dead or slow A must look dead rather than hang the
	# app. Then `/state?wait=30` arrived, whose entire job is *not* to answer
	# until something changes -- so Caddy gave up after five seconds and the
	# phone's permanent notification read "HTTP 504" under the word Ховайся,
	# which is exactly how he found it.
	#
	# Raising the timeout for everything would have thrown away the property it
	# was there for. So the endpoint that is meant to wait is allowed to, and
	# nothing else is. A hung-but-listening A is still spotted in five seconds
	# on `/health`, which is what the app's own status line reads, and Caddy's
	# active check marks the upstream down for every path anyway. A dead one
	# fails on `dial_timeout` in three seconds regardless.
	@waiting path /state
	route {
		reverse_proxy @waiting PRIVATE_IP:8080 {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 3s
				# Above the API's own `MAX_WAIT_S`, with room for the network.
				response_header_timeout 45s
			}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}

		reverse_proxy PRIVATE_IP:8080 {
			header_up X-Real-IP {remote_host}
			# A dead or slow A must look dead rather than hang the app.
			transport http {
				dial_timeout 3s
				response_header_timeout 5s
			}
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /var/log/caddy/hovaysya.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
