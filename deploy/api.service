[Unit]
Description=Hovaysya API — the feed, the decisions and one person's settings
Documentation=https://github.com/vinnivlad/Hovaysya/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hovaysya-api
Group=hovaysya-api
WorkingDirectory=/home/ubuntu/hovaysya
# Bound to localhost. Caddy terminates TLS in front and talks to it here, so
# nothing in this unit handles a certificate or a private key.
ExecStart=/usr/bin/python3 -X utf8 -m tools.serve.api --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

# This process is reachable from the internet and the watcher is not, so it gets
# the tighter jacket of the two. Everything below is refusal rather than trust.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# read-only rather than yes: `yes` makes /home inaccessible, and the working
# directory is under it, so the service died with 200/CHDIR before it could
# open a socket. Read-only keeps the useful half -- it cannot write anywhere
# in /home except the one path below.
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# Read the corpus and the decision log; write only where settings live.
#
# This does *not* stop the service reading a secret in the same tree -- I claimed
# it did, and `ReadOnlyPaths` grants read access, so the claim was backwards. What
# actually keeps the bot token away from it is that the token is on the other
# machine: B has no bot, no chat id, and nothing to post with.
ReadOnlyPaths=/home/ubuntu/hovaysya
ReadWritePaths=/home/ubuntu/hovaysya/data/recipients
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
