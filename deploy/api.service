[Unit]
Description=Hovaysya API — the feed, the decisions and one person's settings
Documentation=https://github.com/vinnivlad/Hovaysya/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hovaysya-api
Group=hovaysya-api
WorkingDirectory=/home/ubuntu/hovaysya
# Bound to this machine's private VCN address, because Caddy is on the *other*
# machine now: the app talks TLS to B, B proxies over the private network to A,
# and A answers from the database the watcher has just written. Nothing is
# replicated and nothing is stale -- his constraint, and the reason for the
# shape: "якщо треба чекати поки щось запушиться, а потім поки застосунок
# опитає - то сенс застосунку губиться".
#
# `%H` is not enough here; the address is written in by install-api.sh.
ExecStart=/usr/bin/python3 -X utf8 -m tools.serve.api --host PRIVATE_IP --port 8080
Restart=always
RestartSec=5

# This process is reachable from the internet and the watcher is not, so it gets
# the tighter jacket of the two. Everything below is refusal rather than trust.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# read-only rather than yes: `yes` makes /home inaccessible, and the working
# directory is under it, so the service died with 200/CHDIR before it could
# open a socket. Read-only keeps the useful half -- it cannot write anywhere
# in /home except the one path below.
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
# Read the corpus and the decision log; write only where settings live.
#
# Read the corpus and the decision log; write only where settings live.
#
# The bot token is now on *this* machine, so the argument that used to keep it
# away -- it lives on the other box -- is gone. `ReadOnlyPaths` grants read
# access, so it has to be named and denied explicitly. This is the one real cost
# of moving the API onto A, and it is paid here rather than argued away.
ReadOnlyPaths=/home/ubuntu/hovaysya
ReadWritePaths=/home/ubuntu/hovaysya/data/recipients
# The leading `-` means "if it is there". Without it systemd refuses to start
# the unit at all -- "Failed to set up mount namespacing: ... No such file or
# directory" -- and `duckdns.token` only exists on B, so denying it by absolute
# path made the service unstartable on the very machine it now runs on.
InaccessiblePaths=-/home/ubuntu/hovaysya/data/telegram-bot.token
InaccessiblePaths=-/home/ubuntu/hovaysya/data/telegram-chat.id
InaccessiblePaths=-/home/ubuntu/hovaysya/data/runbook.md
InaccessiblePaths=-/home/ubuntu/hovaysya/data/duckdns.token
MemoryMax=192M
TasksMax=64

[Install]
WantedBy=multi-user.target
